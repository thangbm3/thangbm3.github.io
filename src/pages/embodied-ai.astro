    <script is:inline>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      for (const flowButton of document.querySelectorAll('[data-flow-play]')) {
        const flow = flowButton.closest('figure');

        function syncMotionPreference() {
          flowButton.hidden = reducedMotion.matches;
          if (reducedMotion.matches) flow.classList.remove('is-playing');
        }

        function playFlow() {
          autoplay.disconnect();
          flow.classList.remove('is-playing');
          void flow.offsetWidth;
          flow.classList.add('is-playing');
          flowButton.textContent = 'Replay animation';
        }

        const autoplay = new IntersectionObserver(([entry]) => {
          if (entry.intersectionRatio >= .45 && !reducedMotion.matches) playFlow();
        }, { threshold: .45 });

        flowButton.addEventListener('click', playFlow);
        autoplay.observe(flow.querySelector('svg'));

        reducedMotion.addEventListener('change', syncMotionPreference);
        syncMotionPreference();
      }
    </script>
