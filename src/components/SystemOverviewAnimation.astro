---
const stages = [
  { platform: 'MAC MINI M4', title: 'Reasoner', role: 'What should the robot do?', detail: 'Use the instruction and scene evidence to propose a semantic task plan.' },
  { platform: 'MAC → LINUX', title: 'Interpreter', role: 'What does execution need?', detail: 'Check plan and object references, then pass task intent and scene evidence to Linux.' },
  { platform: 'LINUX', title: 'Executor', role: 'How should the robot move?', detail: 'Integrate modified GRIT manipulation commands with C++ RMPflow motion execution.' },
];
---
<figure class="system-story" data-system-story>
  <div class="story-stage">
    <div class="story-command" data-story-step>
      <span class="mono">EXAMPLE HUMAN INSTRUCTION</span>
      <p>“Tilt the bottle toward the cup.”</p>
    </div>
    <ol class="story-stages" aria-label="Illustrative architecture">
      {stages.map(({ platform, title, role, detail }) => (
        <li class="story-card" data-story-step>
          <span class="mono">{platform}</span>
          <h3>{title}</h3>
          <p class="story-role">{role}</p>
          <p>{detail}</p>
        </li>
      ))}
    </ol>
    <div class="story-robot" data-story-step>
      <svg viewBox="0 0 120 70" aria-hidden="true">
        <rect x="50" y="18" width="20" height="32" rx="4" fill="currentColor" />
        <circle cx="60" cy="10" r="7" fill="currentColor" />
        <rect x="54" y="50" width="12" height="16" fill="currentColor" />
        <g class="story-arm left"><rect x="22" y="20" width="28" height="6" rx="3" /></g>
        <g class="story-arm right"><rect x="70" y="20" width="28" height="6" rx="3" /></g>
      </svg>
      <strong>RB-Y1 action in MuJoCo</strong>
    </div>
  </div>
  <figcaption>Illustrative system flow · MuJoCo integration in progress · No fluid simulation</figcaption>
  <button type="button" class="pill-link secondary-pill" hidden>Play animation</button>
  <progress aria-label="Animation progress" max="5" value="0" hidden></progress>
</figure>

<style>
  .system-story { container-type: inline-size; margin: 24px 0 0; }
  .story-stage { padding: clamp(12px, 3cqw, 22px); background: #fbfaf7; border: 1px solid #c9d3c4; border-radius: 14px; }
  .story-command, .story-card, .story-robot { border: 1px solid #c9d3c4; border-radius: 10px; padding: 12px; background: #fff; min-width: 0; }
  .story-command p, .story-card p { margin: 4px 0 0; font-size: .88rem; line-height: 1.5; }
  .story-command .mono, .story-card .mono { color: #52615c; font-size: .66rem; }
  .story-card h3 { font-size: 1rem; margin: 5px 0; }
  .story-card .story-role { color: #315c43; font-weight: 650; }
  .story-stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 21px; }
  .story-card, .story-robot { position: relative; }
  .story-card::before, .story-robot::before { content: '↓'; position: absolute; top: -22px; left: 12px; color: #537e47; line-height: 21px; }
  .story-command { margin-bottom: 21px; }
  .story-robot { margin-top: 21px; display: flex; align-items: center; gap: 10px; font-size: .88rem; }
  .story-robot svg { width: 72px; flex: none; color: #243a30; }
  .story-arm { fill: #537e47; transform-box: fill-box; transition: transform .7s ease; }
  .story-arm.left { transform-origin: right center; }
  .story-arm.right { transform-origin: left center; }
  .story-robot.active .left { transform: rotate(-28deg); }
  .story-robot.active .right { transform: rotate(28deg); }
  [data-story-step] { transition: border-color .3s, background-color .3s; }
  [data-story-step].active { border-color: #537e47; background: #e6ede1; }
  .active::before { color: #236347; animation: story-handoff .5s ease-out; }
  @keyframes story-handoff { from { transform: translateY(-5px); opacity: .35; } to { transform: translateY(0); opacity: 1; } }
  .system-story figcaption { color: #52615c; font-size: .82rem; margin: 8px 0 12px; }
  .system-story [hidden] { display: none; }
  progress { width: min(120px, 35%); height: .5rem; margin-left: 10px; accent-color: #537e47; vertical-align: middle; }

  @container (min-width: 520px) {
    .story-stages { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .story-card + .story-card::before { content: '→'; top: 12px; left: -17px; }
    .story-robot::before { left: auto; right: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-arm, [data-story-step] { transition: none; }
    .active::before { animation: none; }
  }
</style>

<script>
  for (const story of document.querySelectorAll<HTMLElement>('[data-system-story]')) {
    const button = story.querySelector('button')!;
    const progress = story.querySelector('progress')!;
    const steps = [...story.querySelectorAll('[data-story-step]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;

    function showStep(index: number) {
      steps.forEach((step, position) => step.classList.toggle('active', position === index));
      progress.value = index + 1;
      if (index + 1 < steps.length) {
        timer = window.setTimeout(() => showStep(index + 1), 2400);
      }
    }

    function syncMotionPreference() {
      button.hidden = reducedMotion.matches;
      if (reducedMotion.matches) {
        window.clearTimeout(timer);
        progress.hidden = true;
        steps.forEach(step => step.classList.remove('active'));
      }
    }

    button.addEventListener('click', () => {
      window.clearTimeout(timer);
      progress.hidden = false;
      button.textContent = 'Replay animation';
      showStep(0);
    });

    reducedMotion.addEventListener('change', syncMotionPreference);
    syncMotionPreference();
  }
</script>
